# Go
/engine/bin/
*.exe
*.test
*.out

# Release artifacts. The release workflow builds these under engine/dist/;
# unanchored so it also catches a local build in the same place.
dist/

# Node
node_modules/
.next/
out/
.vercel/

# Python: the relay rig's own venv, needed because fastmcp requires
# Python >=3.10 and this repo has no other Python dependency to pin one for.
tools/relay-rig/.venv/
__pycache__/
*.pyc

# Local state: this is where credentials and the journal live. Never commit it.
.nim/
*.db
*.journal
tools/relay-rig/nim-home/

# Env
.env
.env.*
!.env.example

# Agent workspace: local settings and scratch worktrees, never the project's.
.claude/

# Editors / OS
.idea/
.vscode/
.DS_Store
.env*
